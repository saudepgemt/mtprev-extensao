{
  "manifest_version": 3,
  "name": "CDSP - Extensão Geral",
  "version": "2.0.65",
  "version_name": "2.65",
  "description": "Menu CDSP no SPA com relatorios, fluxo de correcao, autos, oficios e duplicados por PDF.",
  "permissions": ["scripting", "offscreen", "alarms", "storage", "clipboardWrite", "downloads", "unlimitedStorage", "notifications"],
  "host_permissions": [
    "https://spa.pge.mt.gov.br/*",
    "https://pje-mcp-worker-tjmt.joaooliveira.workers.dev/*",
    "https://pje.tjmt.jus.br/*",
    "https://pje2.tjmt.jus.br/*",
    "https://www.sigadoc.mt.gov.br/*",
    "https://sigadoc.mt.gov.br/*",
    "https://docs.google.com/*"
  ],
  "background": {
    "service_worker": "js/background.js"
  },
  "icons": {
    "16": "images/icon-mtprev16.png",
    "48": "images/icon-mtprev48.png",
    "128": "images/icon-mtprev128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://spa.pge.mt.gov.br/*"],
      "js": [
        "js/content_bridge.js",
        "js/process_watch_panel.js",
        "js/extrator/content.js"
      ],
      "css": [
        "css/extrator.css",
        "css/menu.css",
        "css/process_watch.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.sigadoc.mt.gov.br/*",
        "https://sigadoc.mt.gov.br/*"
      ],
      "js": [
        "js/extrator/content.js"
      ],
      "css": [
        "css/extrator.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["images/logo-mtprev.png", "images/icon-mtprev128.png", "images/material-rounded/*.svg", "data/equipe.xlsx"],
      "matches": ["https://spa.pge.mt.gov.br/*"]
    }
  ],
  "action": {
    "default_title": "CDSP - Extensão Geral",
    "default_icon": {
      "16": "images/icon-mtprev16.png",
      "48": "images/icon-mtprev48.png",
      "128": "images/icon-mtprev128.png"
    }
  }
}
